# Django Backend Configuration
# Copy this file to .env in the project root and fill in your values

# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-django
DEBUG=False
ALLOWED_HOSTS=your-vps-ip,yourdomain.com,localhost,127.0.0.1

# CORS Settings (comma-separated, NO trailing slashes!)
CORS_ALLOWED_ORIGINS=https://your-vps-ip,https://yourdomain.com

# CSRF Settings (comma-separated, NO trailing slashes!)
CSRF_TRUSTED_ORIGINS=https://your-vps-ip,https://yourdomain.com

# Database Configuration - PostgreSQL (Production - Supabase Transaction Pooler)
# Using Transaction Pooler is recommended for better performance and IPv4 compatibility
DATABASE_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_database_password
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543

# Alternative: Direct Connection (for backup scripts)
# DB_HOST=db.your_project_ref.supabase.co
# DB_PORT=5432

# Alternative: Use DATABASE_URL (if your hosting provider provides it)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# For Development (SQLite)
# DATABASE_ENGINE=sqlite3
# Leave other DB_ variables empty for SQLite

# Static Files
STATIC_ROOT=/app/staticfiles
STATIC_URL=/static/

# Media Files
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# Frontend Configuration
# Create frontend/.env.production with this variable
VITE_API_BASE_URL=https://your-vps-ip/api/

# Optional: Sentry for error tracking
# SENTRY_DSN=your-sentry-dsn-here

# Optional: Email configuration
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
